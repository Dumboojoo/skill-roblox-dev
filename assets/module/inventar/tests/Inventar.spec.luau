local Logic = require("../src/shared/Inventory/Logic")

local function empty()
	return { Slots = {}, Equipped = {}, NextUid = 1 }
end

return function(t)
	t.test("Inventar: stapelbare Gegenstände füllen Stapel und legen neue an", function()
		local inventory = empty()
		t.equal(Logic.Add(inventory, "Ore", 25, 10, 60), 25)
		t.equal(#inventory.Slots, 3)
		t.equal(inventory.Slots[3].Count, 5)
		t.equal(Logic.Add(inventory, "Ore", 7, 10, 60), 7)
		t.equal(#inventory.Slots, 4)
		t.equal(inventory.Slots[3].Count, 10)
		t.equal(inventory.Slots[4].Count, 2)
		t.equal(Logic.Count(inventory, "Ore"), 32)
	end)

	t.test("Inventar: nicht stapelbare bekommen je einen Platz und eine eigene Uid", function()
		local inventory = empty()
		t.equal(Logic.Add(inventory, "Sword", 3, 1, 60), 3)
		t.equal(#inventory.Slots, 3)
		t.equal(inventory.Slots[1].Uid, 1)
		t.equal(inventory.Slots[3].Uid, 3)
		t.equal(inventory.NextUid, 4)
	end)

	t.test("Inventar: volles Inventar nimmt nur, was passt", function()
		local inventory = empty()
		t.equal(Logic.Add(inventory, "Sword", 5, 1, 3), 3)
		t.equal(Logic.Add(inventory, "Sword", 1, 1, 3), 0)
		t.equal(Logic.SpaceFor(inventory, "Sword", 1, 3), 0)
	end)

	t.test("Inventar: SpaceFor zählt freie Plätze und angefangene Stapel", function()
		local inventory = empty()
		Logic.Add(inventory, "Ore", 4, 10, 2)
		t.equal(Logic.SpaceFor(inventory, "Ore", 10, 2), 16)
		t.equal(Logic.SpaceFor(inventory, "Gem", 10, 2), 10)
	end)

	t.test("Inventar: Remove ist alles oder nichts", function()
		local inventory = empty()
		Logic.Add(inventory, "Ore", 15, 10, 60)
		t.falsy(Logic.Remove(inventory, "Ore", 16))
		t.equal(Logic.Count(inventory, "Ore"), 15)
		t.truthy(Logic.Remove(inventory, "Ore", 12))
		t.equal(Logic.Count(inventory, "Ore"), 3)
		t.equal(#inventory.Slots, 1)
	end)

	t.test("Inventar: Entfernen eines ausgerüsteten Stücks löst die Ausrüstung", function()
		local inventory = empty()
		Logic.Add(inventory, "Sword", 1, 1, 60)
		inventory.Equipped.Weapon = 1
		t.truthy(Logic.RemoveFromSlot(inventory, 1, 1))
		t.equal(inventory.Equipped.Weapon, nil)
		t.equal(#inventory.Slots, 0)
	end)

	t.test("Inventar: RemoveFromSlot prüft Menge und Uid", function()
		local inventory = empty()
		Logic.Add(inventory, "Potion", 3, 20, 60)
		t.falsy(Logic.RemoveFromSlot(inventory, 1, 4))
		t.falsy(Logic.RemoveFromSlot(inventory, 99, 1))
		t.truthy(Logic.RemoveFromSlot(inventory, 1, 2))
		t.equal(inventory.Slots[1].Count, 1)
	end)
end
